{
  "name": "@sandbox/mind-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=@sandbox/mind-assistant-web && node scripts/build.mjs",
    "check": "npm run check --workspace=@sandbox/mind-assistant-web",
    "test": "node scripts/test.mjs",
    "services:up": "docker compose up --build --wait -d",
    "services:down": "docker compose down",
    "db:migrate": "docker compose exec -T api php database/migrate.php"
  }
}
