{
  "name": "sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Личный монорепозиторий приложений и агентской обвязки",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "apps/memo/frontend",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:harness && npm run check:sites && npm run check --workspace=@sandbox/memo && npm test && npm run test:sites && npm run test:deploy:memo && npm run format:check",
    "check:sites": "node scripts/build-sites.mjs --check",
    "build:sites": "node scripts/build-sites.mjs",
    "dev:sites": "node scripts/preview-sites.mjs",
    "dev:memo": "npm run dev --workspace=@sandbox/memo",
    "build:memo": "npm run build --workspace=@sandbox/memo",
    "test:memo": "npm run test --workspace=@sandbox/memo",
    "check:harness": "node scripts/check-harness.mjs",
    "test": "node --test scripts/*.test.mjs .agents/hooks/scripts/*.test.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node scripts/doctor.mjs",
    "timeweb": "node scripts/timeweb.mjs",
    "test:sites": "npm test --workspace=@sandbox/purpur && npm test --workspace=@sandbox/stonehaus",
    "deploy:memo": "node apps/memo/scripts/deploy.mjs",
    "test:deploy:memo": "npm run test:deploy --workspace=@sandbox/memo",
    "release:memo": "node apps/memo/scripts/request-release.mjs",
    "deploy:sites": "node scripts/deploy-sites.mjs",
    "test:legacy:memo": "npm run test:legacy --workspace=@sandbox/memo",
    "test:restore:memo": "node apps/memo/scripts/verify-backup.mjs"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
